{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Executar Pipeline Principal (main_pipeline.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_pipeline.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Arquivo Atual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
